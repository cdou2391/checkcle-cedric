FROM golang:1.21-alpine AS build

RUN apk add --no-cache git

WORKDIR /app

# Copy Go module files and download dependencies
COPY server/service-operation/go.mod server/service-operation/go.sum ./
RUN go mod download

# Copy source and build
COPY server/service-operation/. .
RUN CGO_ENABLED=0 GOOS=linux go build -o /service-operation main.go

FROM alpine:3.20

RUN apk add --no-cache ca-certificates curl

WORKDIR /app

COPY --from=build /service-operation /app/service-operation

EXPOSE 8091

CMD ["/app/service-operation"]
